   "metadata": {},
   "outputs": [],
   "source": [
    "dof_tslmf <- nrow(tidy(TSLM_fit_unmodified))\n",
    "\n",
    "TSLM_fit_unmodified |>\n",
    "    augment() |>\n",
    "    features(.innov, list(ljung_box = ljung_box, box_pierce = box_pierce), lag = 12, dof = 6) |>\n",
    "    select(contains(\"pvalue\") | contains(\"stat\"))\n",
    "\n",
    "n <- nrow(TR)\n",
    "tibble(\n",
